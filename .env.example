# ── LLM provider (all free) ─────────────────────────────────────────────
# auto (default) | groq | gemini | openrouter | ollama | heuristic
REPOPILOT_LLM_PROVIDER=auto

# Free-tier API keys (auto-detected; any one is enough)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Local Ollama (100% free & private)
OLLAMA_URL=http://127.0.0.1:11434
REPOPILOT_OLLAMA_MODEL=qwen2.5-coder:7b

# Model overrides
REPOPILOT_GROQ_MODEL=llama-3.3-70b-versatile
REPOPILOT_GEMINI_MODEL=gemini-2.0-flash
REPOPILOT_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Retrieval / indexing ────────────────────────────────────────────────
REPOPILOT_EMBEDDER=auto        # auto | hash | sbert
REPOPILOT_SBERT_MODEL=sentence-transformers/all-MiniLM-L6-v2
REPOPILOT_TOP_K=10

# ── Execution sandbox ───────────────────────────────────────────────────
REPOPILOT_EXECUTOR=auto        # auto | docker | subprocess
REPOPILOT_TEST_TIMEOUT=120     # seconds per pytest run
REPOPILOT_VERIFY_ITERS=2       # verification-loop iterations

# ── API ─────────────────────────────────────────────────────────────────
REPOPILOT_CORS=*
BACKEND_URL=http://127.0.0.1:8000   # used by the Next.js proxy (frontend)
